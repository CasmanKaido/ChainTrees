# WalletConnect Configuration
# Get your Project ID from: https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# RPC Endpoints
# Get from: https://infura.io or https://alchemy.com
VITE_INFURA_KEY=your_infura_key_here
VITE_ALCHEMY_KEY=your_alchemy_key_here

# IPFS Storage (Pinata)
# Get from: https://pinata.cloud
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET=your_pinata_secret_here

# Etherscan API Keys (for contract verification)
# Get from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
ARBISCAN_API_KEY=your_arbiscan_api_key_here
BASESCAN_API_KEY=your_basescan_api_key_here

# Private Key for Contract Deployment (NEVER COMMIT THIS!)
# Use a test wallet with testnet funds only
PRIVATE_KEY=your_private_key_here

# Application Settings
VITE_APP_NAME=ChainTrees
VITE_APP_URL=https://chaintrees.io
VITE_APP_DESCRIPTION=Plant trees on-chain and track your environmental impact
