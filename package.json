{
    "name": "chaintrees",
    "version": "1.1.0",
    "description": "NFT Tree Planting Platform - Blockchain for environmental impact",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"src/**/*.{js,css}\"",
        "test": "vitest",
        "test:coverage": "vitest --coverage",
        "test:integration": "vitest tests/integration",
        "deploy": "npm run build && vercel --prod"
    },
    "keywords": [
        "nft",
        "blockchain",
        "web3",
        "environment",
        "carbon-offset",
        "dao",
        "ethereum",
        "walletconnect"
    ],
    "author": "ChainTrees Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/CasmanKaido/ChainTrees.git"
    },
    "bugs": {
        "url": "https://github.com/CasmanKaido/ChainTrees/issues"
    },
    "homepage": "https://github.com/CasmanKaido/ChainTrees#readme",
    "dependencies": {
        "@reown/appkit": "^1.8.14",
        "@reown/appkit-adapter-wagmi": "^1.8.14",
        "@tanstack/react-query": "^5.90.11",
        "@walletconnect/web3-provider": "^1.8.0",
        "animate.css": "^4.1.1",
        "chart.js": "^4.5.1",
        "socket.io-client": "^4.7.2",
        "viem": "^2.40.3",
        "vite": "^5.0.0",
        "wagmi": "^2.19.5",
        "web-vitals": "^3.5.0"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^1.0.4",
        "eslint": "^8.55.0",
        "jsdom": "^23.0.0",
        "prettier": "^3.1.1",
        "vitest": "^1.0.4"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=9.0.0"
    }
}